<view class="page">
  <view class="title">我的</view>
  <view wx:if="{{busy}}">正在处理…</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <button wx:if="{{error && !account}}" bindtap="load">重试</button>
  <view wx:if="{{account}}">
    <view>用户名 {{account.username}}</view>
    <navigator url="/pages/papers/index">练习试卷</navigator>
    <navigator url="/pages/tasks/index">我的年级任务</navigator>
    <button wx:if="{{!confirming}}" bindtap="confirm" disabled="{{busy}}">退出并解除微信绑定</button>
    <view wx:else>
      <view>解除绑定后需使用平台账号重新绑定。</view>
      <button bindtap="unlink" disabled="{{busy}}">确认退出并解绑</button>
      <button bindtap="cancel" disabled="{{busy}}">取消</button>
    </view>
  </view>
</view>
