<view class="page">
  <view class="title">{{mode === 'register' ? '注册学生账号' : '绑定学生账号'}}</view>
  <view wx:if="{{busy}}">正在处理…</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <button wx:if="{{!unbound && !busy}}" bindtap="autoLogin">重试微信登录</button>
  <form wx:if="{{unbound}}" bindsubmit="submit">
    <label>用户名<input name="username" maxlength="32" disabled="{{busy}}" /></label>
    <label>密码<input name="password" password value="{{password}}" bindinput="updatePassword" disabled="{{busy}}" /></label>
    <picker wx:if="{{mode === 'register'}}" range="{{gradeNames}}" value="{{gradeIndex}}"
      bindchange="selectGrade" disabled="{{busy || !grades.length}}">
      <view class="picker">{{gradeIndex >= 0 ? gradeNames[gradeIndex] : '选择年级'}}</view>
    </picker>
    <view wx:if="{{mode === 'register' && !busy && !grades.length}}">暂无可用年级。</view>
    <button form-type="submit" disabled="{{busy}}">{{mode === 'register' ? '注册并绑定' : '绑定已有账号'}}</button>
  </form>
  <button wx:if="{{unbound && mode === 'bind'}}" data-mode="register" bindtap="changeMode" disabled="{{busy}}">注册学生账号</button>
  <button wx:if="{{unbound && mode === 'register'}}" data-mode="bind" bindtap="changeMode" disabled="{{busy}}">返回绑定</button>
</view>
