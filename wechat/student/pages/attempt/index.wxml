<view class="page">
  <view class="title">答卷</view>
  <view>{{status}}</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <button wx:if="{{status === '待同步' || status === '保存失败，待重试'}}" bindtap="retry">重试同步</button>
  <view wx:for="{{questions}}" wx:key="questionId" wx:for-item="question">
    <view>第 {{index + 1}} 题 · {{question.type}}</view>
    <rich-text nodes="{{question.stemHtml}}" />
    <radio-group wx:if="{{question.type === 'SINGLE' || question.type === 'TRUE_FALSE'}}"
      data-id="{{question.questionId}}" data-type="{{question.type}}" bindchange="edit">
      <label wx:for="{{question.options}}" wx:key="id" wx:for-item="option"><radio value="{{option.id}}" disabled="{{!editable}}" checked="{{option.checked}}"/>{{option.text}}</label>
    </radio-group>
    <checkbox-group wx:elif="{{question.type === 'MULTIPLE'}}" data-id="{{question.questionId}}" data-type="MULTIPLE" bindchange="edit">
      <label wx:for="{{question.options}}" wx:key="id" wx:for-item="option"><checkbox value="{{option.id}}" disabled="{{!editable}}" checked="{{option.checked}}"/>{{option.text}}</label>
    </checkbox-group>
    <textarea wx:elif="{{question.type === 'GAP' || question.type === 'SHORT'}}" data-id="{{question.questionId}}"
      data-type="{{question.type}}" value="{{question.currentText}}" disabled="{{!editable}}"
      bindinput="edit" maxlength="10000" placeholder="填写答案" />
    <button data-id="{{question.questionId}}" disabled="{{!editable}}" bindtap="clear">清空本题</button>
  </view>
</view>
