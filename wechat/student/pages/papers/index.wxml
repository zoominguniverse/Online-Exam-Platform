<view class="page">
  <view class="title">练习试卷</view>
  <view wx:if="{{busy}}">正在加载试卷…</view>
  <view wx:elif="{{error}}" class="error">{{error}}<button bindtap="retry">重试</button></view>
  <view wx:elif="{{!items.length}}">暂无练习试卷。</view>
  <view wx:for="{{items}}" wx:key="id">
    <view>{{item.name}}</view>
    <view>{{item.typeLabel}} · {{item.durationMinutes}} 分钟 · {{item.statusLabel}}</view>
    <view wx:if="{{item.window}}">{{item.window}}（香港时间）</view>
    <button data-id="{{item.id}}" disabled="{{item.status !== 'OPEN'}}" bindtap="start">开始作答</button>
  </view>
  <button bindtap="previous" disabled="{{busy || page <= 1}}">上一页</button>
  <button bindtap="next" disabled="{{busy || page * 20 >= total}}">下一页</button>
</view>
