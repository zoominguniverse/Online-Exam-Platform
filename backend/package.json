{
  "name": "exam-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "start": "node src/main.ts",
    "migrate": "node src/cli.ts migrate",
    "rollback": "node src/cli.ts rollback",
    "seed": "node src/cli.ts seed",
    "create-user": "node src/cli.ts create-user",
    "worker": "node src/worker.ts",
    "outbox:replay": "node src/cli.ts outbox-replay",
    "check": "node scripts/check.mjs",
    "api:write": "node scripts/openapi.mjs --write",
    "test": "node scripts/test.mjs",
    "gate": "npm run build && npm run check && npm test"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.0",
    "bcryptjs": "3.0.3",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "typescript": "5.9.3"
  }
}
